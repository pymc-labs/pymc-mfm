<%
// One panel per model, in `order`. Released models come from docs/models/<name>/index.qmd
// (title, date, summary, and optional `badge` and `specs`); a wave of tiles, painted by
// tiles-pages.js, stands in for a picture. The panel's text links to the release page.
// Announced models come from upcoming.yml with `status: soon`; they say "Coming soon" and
// link nowhere.
// Pandoc reads this output as Markdown: keep HTML lines unindented, without blank lines.
%>
<div class="mfm-releases list">
<% for (const item of items) { const soon = item.status === "soon"; %>
<article class="mfm-release<%= soon ? ' is-soon' : '' %> quarto-post" <%= metadataAttrs(item) %><%= soon ? ' aria-disabled="true"' : '' %>>
<div class="mfm-panel" aria-hidden="true"><canvas></canvas></div>
<div class="mfm-release__body">
<h2 class="no-anchor"><%= item.title %></h2>
<% if (soon) { %><p class="mfm-release__meta">Coming soon</p><% } else { %><p class="mfm-release__meta"><span><%= item.date %></span><% if (item.badge) { %><span class="mfm-model__badge"><%= item.badge %></span><% } %></p><% } %>
<% if (item.summary) { %><p class="mfm-release__summary"><%= item.summary %></p><% } %>
<% if (item.specs && item.specs.length) { %><ul class="mfm-release__specs"><% for (const spec of item.specs) { %><li><%= spec %></li><% } %></ul><% } %>
<% if (!soon) { %><p><a class="mfm-go no-external" href="<%- item.path %>" aria-label="Read the <%= item.title %> release">Read the release <span aria-hidden="true">→</span></a></p><% } %>
</div>
</article>
<% } %>
</div>
