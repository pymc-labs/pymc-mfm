<%
// One tile per model, in `order`. Released models come from docs/models/<name>/index.qmd
// (title, date, summary, image, and optional `name`, `badge` and `specs`; the tile
// shows `name`, the model without its version, or else the title); the whole tile links
// to the release page. Announced models come from upcoming.yml with `status: soon`; their
// tile says "Coming soon" and links nowhere.
// Pandoc reads this output as Markdown: keep HTML lines unindented, without blank lines.
const slug = (title) => String(title).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
%>
<div class="mktfm-models">
<div class="mktfm-models__grid list">
<% for (const item of items) { const soon = item.status === "soon"; %>
<article class="mktfm-model mktfm-model--<%= slug(item.title) %><%= soon ? ' is-soon' : '' %> quarto-post" <%= metadataAttrs(item) %><%= soon ? ' aria-disabled="true"' : '' %>>
<div class="mktfm-model__picture">
<% if (item.image) { %><img src="<%- item.image %>" alt="" loading="lazy"><% } %>
<p class="mktfm-model__name" role="heading" aria-level="2"><%= item.name || item.title %></p>
</div>
<div class="mktfm-model__body">
<% if (soon) { %><p class="mktfm-model__meta">Coming soon</p><% } else { %><p class="mktfm-model__meta"><span><%= item.date %></span><% if (item.badge) { %><span class="mktfm-model__badge"><%= item.badge %></span><% } %></p><% } %>
<% if (item.summary) { %><p class="mktfm-model__summary"><%= item.summary %></p><% } %>
<% if (item.specs && item.specs.length) { %><ul class="mktfm-model__specs"><% for (const spec of item.specs) { %><li><%= spec %></li><% } %></ul><% } %>
<% if (!soon) { %><p class="mktfm-model__cta"><a class="stretched-link no-external" href="<%- item.path %>" aria-label="Read the <%= item.title %> release">Read the release <span aria-hidden="true">→</span></a></p><% } %>
</div>
</article>
<% } %>
</div>
</div>
