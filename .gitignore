# Website build (docs/): rendered site, Quarto cache and pages generated at pre-render.
# Quarto also writes docs/.gitignore, but the sdist build reads only this file.
/docs/_site/
/docs/.quarto/
/docs/guide/examples/
/docs/reference/
/docs/api/*.qmd
/docs/api/_sidebar.yml
/docs/objects.json
/docs/**/*.quarto_ipynb
